global
    log stdout format raw local0
    maxconn 4096
    uid     0

defaults
    log     global
    mode    tcp
    option  tcplog
    timeout connect 5s
    timeout client  1h
    timeout server  1h
    timeout tunnel  1h

resolvers cluster
    parse-resolv-conf
    hold valid 10s

%{ for port, target in web_ports ~}
listen web-${port}
    bind [::]:${port} v6only
    server-template traefik 8 ${traefik_host}:${target} resolvers cluster resolve-prefer ipv4 init-addr none send-proxy-v2 source "$${HOST_IP}"

%{ endfor ~}
%{ for port, target in ssh_ports ~}
listen ssh-${port}
    bind [::]:${port} v6only
    server sshpiper ${target} resolvers cluster resolve-prefer ipv4 init-addr none

%{ endfor ~}
