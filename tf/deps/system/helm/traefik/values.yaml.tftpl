# Traefik for freepod — self-managed Helm release (chart 42.4.1 = Traefik app v3.7.19),
# replacing the k3s-bundled Traefik (disabled via /etc/rancher/k3s/config.yaml).
#
# Clients reach Traefik directly on the floating address, so the Service is a klipper
# LoadBalancer with externalTrafficPolicy: Local. Local is required for the real client IP: with
# the default Cluster policy, kube-proxy SNATs the source to the CNI gateway (10.42.0.1) before
# Traefik sees it.

image:
  tag: "3.7.19"

# One pod per edge node: whichever edge node holds the floating address must serve it.
deployment:
  kind: DaemonSet

# `traefik` IngressClass, marked default — so existing app Ingresses (which carry no explicit
# class) keep matching this controller after the migration off the bundled chart.
ingressClass:
  enabled: true
  isDefaultClass: true
  name: traefik

providers:
  kubernetesCRD:
    # Which namespace the `default` TLSStore is read from. Empty means "wherever
    # one is found", which is not a choice between them: Traefik logs `Default TLS
    # Stores defined in multiple namespaces` and honours NEITHER, serving TRAEFIK
    # DEFAULT CERT for every hostname. Verified on 2026-09-08, at the cost of 90
    # seconds of production. Naming a namespace is what lets the store move without
    # a window -- the pointer moves only once both stores are valid. Requires
    # Traefik >= 3.7; 3.6.10 rejects the field outright and will not start.
    defaultTLSResourcesNamespace: "${default_tls_resources_namespace}"
    # Legacy router names: tenants' HTTP access logs select by them (variables.tf).
    safeNaming: false

  # Serve ExternalName-backed Services referenced by some app Ingresses.
  kubernetesIngress:
    allowExternalNameServices: true
  # Also read nginx-annotated Ingresses (the cluster has an `nginx` IngressClass).
  kubernetesIngressNGINX:
    enabled: true

# websecure (:443) is the ONLY default entrypoint: an Ingress/router without an explicit
# entrypoints annotation binds :443 only, so its plain :80 traffic falls through to the
# cluster-wide HTTP->HTTPS redirect (redirect_https.tf). The IPv6 relays convey the client
# address via PROXY protocol; trust it only from their source addresses.
#
# NOTE: deliberately NO ports.web.http.redirections here. An entrypoint-level redirect runs
# before router matching, so it shadows cert-manager's HTTP-01 solver Ingress and deadlocks
# custom-domain issuance (and leaks the internal :8443 port). The HTTP->HTTPS redirect is a
# low-priority web-only IngressRoute + redirectScheme Middleware instead (redirect_https.tf).
ports:
  web:
    asDefault: false
    http:
      aliasHeadersStrategy: delete
    proxyProtocol:
      trustedIPs:
%{ for ip in ipv6_relay_source_ips ~}
        - "${ip}"
%{ endfor ~}
  websecure:
    asDefault: true
    http:
      aliasHeadersStrategy: delete
      middlewares:
        - "kube-system-headers-hsts@kubernetescrd"
    proxyProtocol:
      trustedIPs:
%{ for ip in ipv6_relay_source_ips ~}
        - "${ip}"
%{ endfor ~}

  # Inbound mail for tf/deps/mx. smtp passes the sender's address on with PROXY protocol;
  # imaps is passed through, TLS and all, to Maddy.
  smtp:
    port: 2525
    expose:
      default: true
    exposedPort: 25
    protocol: TCP
  imaps:
    port: 9993
    expose:
      default: true
    exposedPort: 993
    protocol: TCP

# klipper LoadBalancer owning the node's host ports; Local preserves the client's source IP.
service:
  spec:
    type: LoadBalancer
    externalTrafficPolicy: Local
    # kube-proxy keeps the source of an external IP, like the LoadBalancer IP's; svclb's
    # host port would masquerade it.
    externalIPs:
      - "${floating_ipv4}"

# Local only answers on a node running a Traefik pod, so the pods stay on the edge nodes.
nodeSelector:
  caelus.dev/edge: "true"
tolerations:
  - key: caelus.dev/staging
    operator: Exists
    effect: NoSchedule

# NO tlsStore here. The default certificate store is a platform-owned object in the namespace
# named by providers.kubernetesCRD.defaultTLSResourcesNamespace above (tf/deps/tls), because the
# reconciler adds each account's certificate to it and a chart-rendered object is reset to the
# chart's view of it on every upgrade -- which would drop every account's certificate at once.
# See openspec/changes/per-user-tls-certificates, D3.

# Access logs go to stdout as JSON lines, which Alloy parses (tf/deps/loki) and tenants read
# through `freepod log --http`. Fields and headers are allowlists: a field a later Traefik adds
# stays out of the log store until it is listed here, and so do Cookie and Authorization.
# kubectl -n kube-system logs -f ds/traefik | jq
accessLog:
  enabled: true
  format: json
  fields:
    defaultMode: drop
    names:
      StartUTC: keep
      ClientHost: keep
      RequestHost: keep
      RequestMethod: keep
      RequestPath: keep
      RequestProtocol: keep
      DownstreamStatus: keep
      DownstreamContentSize: keep
      Duration: keep
      RouterName: keep
    headers:
      defaultMode: drop
      names:
        User-Agent: keep
        Referer: keep

metrics:
  prometheus:
    addRoutersLabels: true
    service:
      enabled: true
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "9100"
        prometheus.io/path: "/metrics"
