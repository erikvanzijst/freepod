# Traefik for freepod — self-managed Helm release (chart 41.5.0 = Traefik app v3.7.13),
# replacing the k3s-bundled Traefik (disabled via /etc/rancher/k3s/config.yaml).
#
# Rendered by templatefile(); ${haproxy_edge_ip} is the homelab HAProxy edge IP/CIDR.
#
# Freepod's Traefik is reached by the homelab HAProxy SNI edge at the node's HOST :80/:443
# (cross-cluster), so the Service is a klipper LoadBalancer with externalTrafficPolicy: Local.
# Local is required so the edge IP survives to match proxyProtocol.trustedIPs; with the default
# Cluster policy, kube-proxy SNATs the source to the CNI gateway (10.42.0.1) before Traefik
# sees it, so the PROXY header would be rejected and the real client IP lost.

image:
  tag: "3.7.13"

# `traefik` IngressClass, marked default — so existing app Ingresses (which carry no explicit
# class) keep matching this controller after the migration off the bundled chart.
ingressClass:
  enabled: true
  isDefaultClass: true
  name: traefik

providers:
  kubernetesCRD:
    # Which namespace the `default` TLSStore is read from. Empty means "wherever
    # one is found", which is not a choice between them: Traefik logs `Default TLS
    # Stores defined in multiple namespaces` and honours NEITHER, serving TRAEFIK
    # DEFAULT CERT for every hostname. Verified on 2026-09-08, at the cost of 90
    # seconds of production. Naming a namespace is what lets the store move without
    # a window -- the pointer moves only once both stores are valid. Requires
    # Traefik >= 3.7; 3.6.10 rejects the field outright and will not start.
    defaultTLSResourcesNamespace: "${default_tls_resources_namespace}"

  # Serve ExternalName-backed Services referenced by some app Ingresses.
  kubernetesIngress:
    allowExternalNameServices: true
  # Also read nginx-annotated Ingresses (the cluster has an `nginx` IngressClass).
  kubernetesIngressNGINX:
    enabled: true

# websecure (:443) is the ONLY default entrypoint: an Ingress/router without an explicit
# entrypoints annotation binds :443 only, so its plain :80 traffic falls through to the
# cluster-wide HTTP->HTTPS redirect (redirect_https.tf). The HAProxy edge conveys the real
# client IP via PROXY protocol (send-proxy-v2); trust it ONLY from the edge IP (the old
# blanket forwardedheaders.insecure trust is deliberately gone).
#
# NOTE: deliberately NO ports.web.http.redirections here. An entrypoint-level redirect runs
# before router matching, so it shadows cert-manager's HTTP-01 solver Ingress and deadlocks
# custom-domain issuance (and leaks the internal :8443 port). The HTTP->HTTPS redirect is a
# low-priority web-only IngressRoute + redirectScheme Middleware instead (redirect_https.tf).
ports:
  web:
    asDefault: false
    proxyProtocol:
      trustedIPs:
        - "${haproxy_edge_ip}"
  websecure:
    asDefault: true
    http:
      middlewares:
        - "kube-system-headers-hsts@kubernetescrd"
    proxyProtocol:
      trustedIPs:
        - "${haproxy_edge_ip}"

# klipper LoadBalancer owning the node's host :80/:443; Local preserves the edge source IP.
service:
  type: LoadBalancer
  spec:
    externalTrafficPolicy: Local

# NO tlsStore here. The default certificate store is a platform-owned object in the namespace
# named by providers.kubernetesCRD.defaultTLSResourcesNamespace above (tf/deps/tls), because the
# reconciler adds each account's certificate to it and a chart-rendered object is reset to the
# chart's view of it on every upgrade -- which would drop every account's certificate at once.
# See openspec/changes/per-user-tls-certificates, D3.

# Stream access logs to stdout: kubectl -n kube-system logs -f deploy/traefik
accessLog:
  enabled: true

metrics:
  prometheus:
    addRoutersLabels: true
    service:
      enabled: true
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "9100"
        prometheus.io/path: "/metrics"
