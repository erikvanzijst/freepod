    {
      "id": 17,
      "type": "stat",
      "title": "Quota used",
      "description": "At 100% every write to the pool fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 27,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(ceph_pool_stored / (ceph_pool_quota_bytes > 0)) * on(pool_id) group_left() ceph_pool_metadata{name=\"$pool\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
