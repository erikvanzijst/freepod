#!/usr/bin/env bash
# Installed through the system core.hooksPath (product-upgrade-guardrails). A session holds only
# a read-only token, so GitHub would refuse the push anyway; this refuses before contacting it,
# and explains why.
echo "pre-push: refused by the upgrade service: sessions push nothing; leave your commits and result files, and the service opens the pull request" >&2
exit 1
