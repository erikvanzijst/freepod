#!/usr/bin/env bash
# Installed through the system core.hooksPath (product-upgrade-guardrails). The branch ruleset
# enforces the same rule on GitHub's side; this refuses before contacting it, and explains why.
if [ "${UPGRADE_DRY_RUN:-1}" != 0 ]; then
  echo "pre-push: refused by the upgrade service: this is a dry run, and a dry run pushes nothing" >&2
  exit 1
fi
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/upgrade/*) ;;
    *)
      echo "pre-push: refused by the upgrade service: $remote_ref is outside refs/heads/upgrade/" >&2
      exit 1 ;;
  esac
done
exit 0
