#!/usr/bin/env bash
# git's credential helper: the current installation token for github.com (D8).
[ "${1:-}" = get ] || exit 0
host=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  [ "$key" = host ] && host="$value"
done
[ "$host" = github.com ] && [ -r "${UPGRADER_TOKEN_FILE:-}" ] || exit 0
echo "username=x-access-token"
echo "password=$(cat "$UPGRADER_TOKEN_FILE")"
