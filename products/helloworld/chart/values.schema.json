{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "helloworld values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string",
          "title": "hostname"
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "size": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          },
          "minItems": 1
        },
        "storageClassName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "user": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Text rendered in the generated index.html"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "caelus": {
      "type": "object",
      "description": "Reconciler-injected values. Open by design (additionalProperties: true throughout): this namespace is written by the platform, never by a tenant, so new reconciler fields can land without a schema bump in every chart.",
      "properties": {
        "plan": {
          "type": "object",
          "properties": {
            "storageBytes": {
              "type": "integer"
            },
            "storageSize": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "owner": {
          "type": "object",
          "description": "Deployment owner, injected by the Caelus reconciler",
          "properties": {
            "email": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "ingress": {
          "type": "object",
          "description": "Ingress and per-app TLS settings injected by the Caelus reconciler",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "properties": {
                "wildcard": {
                  "type": "boolean"
                },
                "issuer": {
                  "type": "string"
                },
                "secretName": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ssh-sidecar": {
      "type": "object",
      "description": "Values namespace for the ssh-sidecar library dependency (unused; library charts render no values but Helm still reserves the key)."
    },
    "sshSidecarImage": {
      "type": "string",
      "minLength": 1,
      "description": "The platform's SSH sidecar image, pinned to an exact version. Matched against products/_lib/ssh-sidecar-image/VERSION by api/tests/test_ssh_chart_contract.py."
    }
  },
  "required": [
    "user"
  ],
  "additionalProperties": false
}
