{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vaultwarden values",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "title": "hostname",
      "minLength": 1,
      "maxLength": 253
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "Admin console token. Blank generates a strong one on first install and reuses it. Never exposed to the user."
        },
        "blockAtIngress": {
          "type": "boolean",
          "description": "Serve 403 for /admin at the Ingress. Does not affect in-cluster access."
        }
      },
      "additionalProperties": false
    },
    "signups": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "verify": {
          "type": "boolean"
        },
        "domainsWhitelist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "proxy": {
      "type": "object",
      "properties": {
        "ipHeader": {
          "type": "string",
          "description": "IP_HEADER: header carrying the client IP. Blank omits the env var."
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "webVault": {
          "type": "boolean"
        },
        "sends": {
          "type": "boolean"
        },
        "emergencyAccess": {
          "type": "boolean"
        },
        "passwordHints": {
          "type": "boolean"
        },
        "showPasswordHint": {
          "type": "boolean"
        },
        "orgCreationUsers": {
          "type": "string"
        },
        "emailChangeAllowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "log": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "",
            "trace",
            "debug",
            "info",
            "warn",
            "error",
            "off"
          ]
        }
      },
      "additionalProperties": false
    },
    "smtp": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "from": {
          "type": "string"
        },
        "fromName": {
          "type": "string"
        },
        "security": {
          "type": "string",
          "enum": [
            "off",
            "starttls",
            "force_tls"
          ]
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "accessMode": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "extraEnv": {
      "type": "object",
      "description": "Extra vaultwarden env vars; string values only",
      "additionalProperties": {
        "type": "string"
      }
    },
    "caelus": {
      "type": "object",
      "description": "Reconciler-injected values. Open by design (additionalProperties: true throughout): this namespace is written by the platform, never by a tenant, so new reconciler fields can land without a schema bump in every chart.",
      "properties": {
        "plan": {
          "type": "object",
          "properties": {
            "storageBytes": {
              "type": "integer"
            },
            "storageSize": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "ingress": {
          "type": "object",
          "description": "Ingress and per-app TLS settings injected by the Caelus reconciler",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "properties": {
                "wildcard": {
                  "type": "boolean"
                },
                "issuer": {
                  "type": "string"
                },
                "secretName": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "owner": {
          "type": "object",
          "description": "Deployment owner, injected by the Caelus reconciler",
          "properties": {
            "email": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "bootstrap": {
      "type": "object",
      "description": "First-user bootstrap: the vaultwarden container's postStart hook that invites the owner",
      "properties": {
        "readyTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds the postStart hook waits for vaultwarden to answer /alive before failing the container start"
        }
      },
      "additionalProperties": false
    },
    "ssh-sidecar": {
      "type": "object",
      "description": "Values namespace reserved by the ssh-sidecar library dependency (unused)."
    },
    "sshSidecarImage": {
      "type": "string",
      "minLength": 1,
      "description": "The platform's SSH sidecar image, pinned to an exact version. Matched against products/_lib/ssh-sidecar-image/VERSION by api/tests/test_ssh_chart_contract.py."
    }
  },
  "required": [
    "host",
    "image",
    "service",
    "storage",
    "caelus"
  ],
  "additionalProperties": false
}
