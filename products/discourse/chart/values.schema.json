{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "discourse bespoke chart values",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "title": "hostname",
      "minLength": 1,
      "maxLength": 253
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "enabled",
        "className"
      ],
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "minLength": 5
        },
        "password": {
          "type": "string",
          "description": "First-start password; blank generates one and reuses it thereafter."
        }
      },
      "required": [
        "name",
        "email"
      ],
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "shared": {
          "$ref": "#/$defs/volume"
        }
      },
      "required": [
        "shared"
      ],
      "additionalProperties": false
    },
    "smtp": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "from": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 1,
          "description": "Pitchfork workers (UNICORN_WORKERS)."
        },
        "sidekiqs": {
          "type": "integer",
          "minimum": 1,
          "description": "Sidekiq processes forked by the application server (UNICORN_SIDEKIQS)."
        }
      },
      "required": [
        "workers",
        "sidekiqs"
      ],
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "rateLimit": {
      "type": "object",
      "properties": {
        "perIpPer10Seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "DISCOURSE_MAX_REQS_PER_IP_PER_10_SECONDS"
        },
        "perIpPerMinute": {
          "type": "integer",
          "minimum": 1,
          "description": "DISCOURSE_MAX_REQS_PER_IP_PER_MINUTE"
        }
      },
      "required": [
        "perIpPer10Seconds",
        "perIpPerMinute"
      ],
      "additionalProperties": false
    },
    "uploadBuffering": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxRequestBodyBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "enabled",
        "maxRequestBodyBytes"
      ],
      "additionalProperties": false
    },
    "postgres": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "description": "Upstream's discourse/postgres tag for the PostgreSQL major the standard install runs."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "description": "Blank generates one on first install and reuses it from the <release>-db Secret; it must keep matching what the data directory was seeded with."
            }
          },
          "required": [
            "username",
            "database"
          ],
          "additionalProperties": false
        },
        "persistence": {
          "$ref": "#/$defs/volume"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "image",
        "auth",
        "persistence"
      ],
      "additionalProperties": false
    },
    "redis": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "description": "The Redis major the standard install runs."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "additionalProperties": false
        },
        "persistence": {
          "$ref": "#/$defs/volume"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": [
        "image",
        "persistence"
      ],
      "additionalProperties": false
    },
    "nodePool": {
      "type": "string",
      "description": "Node pool the pods prefer (caelus.dev/node-pool label and taint); empty for none."
    },
    "resources": {
      "type": "object"
    },
    "extraEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "caelus": {
      "type": "object",
      "description": "Reconciler-injected values. Open by design (additionalProperties: true throughout): this namespace is written by the platform, never by a tenant, so new reconciler fields can land without a schema bump in every chart.",
      "properties": {
        "plan": {
          "type": "object",
          "properties": {
            "storageBytes": {
              "type": "integer"
            },
            "storageSize": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "owner": {
          "type": "object",
          "description": "Deployment owner, injected by the Caelus reconciler",
          "properties": {
            "email": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "vars": {
          "type": "object",
          "description": "Name of the Secret holding this deployment's runtime vars; the application reads it with envFrom.",
          "properties": {
            "secretName": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "properties": {
                "wildcard": {
                  "type": "boolean"
                },
                "issuer": {
                  "type": "string"
                },
                "secretName": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ssh-sidecar": {
      "type": "object",
      "description": "Values namespace reserved by the ssh-sidecar library dependency (unused)."
    },
    "sshSidecarImage": {
      "type": "string",
      "minLength": 1,
      "description": "The platform's SSH sidecar image, pinned to an exact version. Matched against products/_lib/ssh-sidecar-image/VERSION by api/tests/test_ssh_chart_contract.py."
    }
  },
  "required": [
    "host",
    "ingress",
    "admin",
    "persistence",
    "web",
    "postgres",
    "redis"
  ],
  "additionalProperties": false,
  "$defs": {
    "volume": {
      "type": "object",
      "properties": {
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadOnlyMany",
            "ReadWriteMany",
            "ReadWriteOncePod"
          ]
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClassName": {
          "type": "string"
        }
      },
      "required": [
        "accessMode",
        "size",
        "storageClassName"
      ],
      "additionalProperties": false
    }
  }
}
