#!/bin/bash
# Run the current app's dev server in the background on port 8080, where the
# preview shows it, with the app's local database and S3 in its environment.
# There is one preview: starting an app stops whatever held the port.
#
#   dev-app          (re)start the app of the current directory and wait until
#                    it answers
#   dev-app stop     stop it
#   dev-app logs     the last lines it printed
set -euo pipefail

PORT=8080
LOG=/tmp/dev-app.log
PIDFILE=/tmp/dev-app.pid

stop() {
  if [ -f "$PIDFILE" ]; then
    kill -- "-$(cat "$PIDFILE")" 2>/dev/null || true
    rm -f "$PIDFILE"
  fi
  # Whatever else holds the port: another app's server or one started by hand.
  fuser -s -k -TERM "$PORT/tcp" 2>/dev/null || true
  for _ in $(seq 20); do
    fuser -s "$PORT/tcp" 2>/dev/null || return 0
    sleep 0.5
  done
  fuser -s -k "$PORT/tcp" 2>/dev/null || true
  sleep 0.5
  fuser -s "$PORT/tcp" 2>/dev/null || return 0
  echo "dev-app: something is still listening on port $PORT" >&2
  return 1
}

case "${1:-start}" in
  stop) stop; exit ;;
  logs) tail -n "${2:-50}" "$LOG"; exit ;;
  start) ;;
  *) echo "usage: dev-app [start|stop|logs]" >&2; exit 2 ;;
esac

# The working directory, not the app's main directory: it may be a worktree.
APP_DIR=$(git rev-parse --show-toplevel 2>/dev/null || true)
appstudio-app name >/dev/null
cd "$APP_DIR"
[ -f package.json ] || { echo "dev-app: no package.json in $APP_DIR; copy the starter in first" >&2; exit 1; }
stop
[ -d node_modules ] || npm install --no-fund --no-audit >&2

eval "$(dev-postgres)"
eval "$(dev-s3)"
PORT=$PORT setsid npm run dev >"$LOG" 2>&1 < /dev/null &
echo $! >"$PIDFILE"

for _ in $(seq 120); do
  if curl -s -o /dev/null "http://127.0.0.1:$PORT/"; then
    echo "Running. Preview: ${APPSTUDIO_PREVIEW_URL:-http://localhost:$PORT} (log: dev-app logs)"
    exit 0
  fi
  # A crashed server leaves `tsx watch` running (it waits for a file change),
  # so a stack trace in the log is the sign to stop waiting.
  if ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null || grep -qE '^\s+at ' "$LOG"; then
    sleep 0.5
    echo "dev-app: the dev server failed to start; its output:" >&2
    tail -n 30 "$LOG" >&2
    exit 1
  fi
  sleep 0.5
done
echo "dev-app: no answer on port $PORT after 60 s; its output:" >&2
tail -n 30 "$LOG" >&2
exit 1
