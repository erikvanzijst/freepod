{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "instructions": [
    "/opt/appstudio/AGENTS.md"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "playwright-mcp",
        "--headless",
        "--browser",
        "chromium",
        "--no-sandbox",
        "--isolated",
        "--idle-timeout",
        "600000",
        "--output-dir",
        "/tmp/playwright-mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "doom_loop": "ask"
  }
}
