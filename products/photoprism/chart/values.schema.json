{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "photoprism bespoke chart values",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "title": "hostname",
      "minLength": 1,
      "maxLength": 253
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Upstream versions are six-digit dates; keep the value quoted in every values file, or YAML delivers an integer and this schema rejects it."
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": ["enabled", "className"],
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "description": "First-start password; blank generates one and reuses it thereafter."
        }
      },
      "required": ["username"],
      "additionalProperties": false
    },
    "trustedProxies": {
      "type": "string"
    },
    "workers": {
      "type": "integer",
      "minimum": 1
    },
    "persistence": {
      "type": "object",
      "properties": {
        "originals": {
          "$ref": "#/$defs/volume"
        },
        "storage": {
          "$ref": "#/$defs/volume"
        }
      },
      "required": ["originals", "storage"],
      "additionalProperties": false
    },
    "mariadb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          },
          "required": ["repository", "tag", "pullPolicy"],
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "description": "Blank generates one on first install and reuses it from the <release>-db Secret; it must keep matching what the data directory was seeded with."
            },
            "rootPassword": {
              "type": "string"
            }
          },
          "required": ["username", "database"],
          "additionalProperties": false
        },
        "bufferPoolSize": {
          "type": "string",
          "minLength": 1
        },
        "persistence": {
          "$ref": "#/$defs/volume"
        },
        "resources": {
          "type": "object"
        }
      },
      "required": ["enabled", "image", "auth", "persistence"],
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "extraEnv": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "caelus": {
      "type": "object",
      "description": "Reconciler-injected values. Open by design (additionalProperties: true throughout): this namespace is written by the platform, never by a tenant, so new reconciler fields can land without a schema bump in every chart.",
      "properties": {
        "plan": {
          "type": "object",
          "properties": {
            "storageBytes": {
              "type": "integer"
            },
            "storageSize": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "owner": {
          "type": "object",
          "description": "Deployment owner, injected by the Caelus reconciler",
          "properties": {
            "email": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "vars": {
          "type": "object",
          "description": "Name of the Secret holding this deployment's runtime vars; the application reads it with envFrom.",
          "properties": {
            "secretName": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "properties": {
                "wildcard": {
                  "type": "boolean"
                },
                "issuer": {
                  "type": "string"
                },
                "secretName": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "ssh-sidecar": {
      "type": "object",
      "description": "Values namespace reserved by the ssh-sidecar library dependency (unused)."
    },
    "sshSidecarImage": {
      "type": "string",
      "minLength": 1,
      "description": "The platform's SSH sidecar image, pinned to an exact version. Matched against products/_lib/ssh-sidecar-image/VERSION by api/tests/test_ssh_chart_contract.py."
    }
  },
  "required": ["host", "ingress", "persistence", "mariadb"],
  "additionalProperties": false,
  "$defs": {
    "volume": {
      "type": "object",
      "properties": {
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClassName": {
          "type": "string"
        }
      },
      "required": ["accessMode", "size", "storageClassName"],
      "additionalProperties": false
    }
  }
}
